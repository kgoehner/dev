# Function to ensure atlas is mounted before using zk
zk() {
    if ! mount | grep -q "atlas._smb._tcp.local"; then
        echo "Mounting atlas..."
        open "smb://atlas._smb._tcp.local/documents" 2>/dev/null || \
        osascript -e 'mount volume "smb://atlas._smb._tcp.local/documents"'
    fi
    command zk "$@"
}

