#!/usr/bin/env bash

if [[ $# -eq 1 ]]; then
    selected=$1
else
    selected=$(
        (
            sesh list -t
            sesh list -z | while read -r dir; do
                [[ -d "${dir/#\~/$HOME}/.git" ]] && echo "$dir"
            done
        ) | fzf
    )
fi

if [[ -z $selected ]]; then
    exit 0
fi

sesh connect "$selected"
