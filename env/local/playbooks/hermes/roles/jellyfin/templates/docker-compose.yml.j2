---
services:
  jellyfin:
    image: jellyfin/jellyfin:latest
    container_name: jellyfin
    restart: unless-stopped
    ports:
      - "8096:8096"
    environment:
      TZ: '{{ timezone }}'
    volumes:
      - ./config:/config
      - ./cache:/cache
      - /mnt/atlas/media/videos:/data/videos
      - /mnt/atlas/media/music:/data/music
    devices:
      - /dev/dri:/dev/dri
