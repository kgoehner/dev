events {
    worker_connections 1024;
}

http {
    client_max_body_size 100M;

    # Redirect HTTP to HTTPS (except hermes.home and kuma)
    server {
        listen 80;
        server_name ~^(?!hermes\.|kuma\.).*.hermes.home$;
        return 301 https://$host$request_uri;
    }

    # HTTP for hermes.home (homepage)
    server {
        listen 80;
        server_name hermes.home hermes.lan;
        location / {
            proxy_pass http://localhost:8084;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }
    }

    # HTTP-only for Paperless (mobile app compatibility)
    # HTTPS servers
    server {
        listen 443 ssl;
        server_name hermes.home hermes.lan;
        ssl_certificate /etc/nginx/ssl/hermes.crt;
        ssl_certificate_key /etc/nginx/ssl/hermes.key;
        location / {
            proxy_pass http://localhost:8084;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }
    }

    server {
        listen 443 ssl;
