events {
    worker_connections 1024;
}

http {
    client_max_body_size 100M;

    # Redirect HTTP to HTTPS (except paperless)
    server {
        listen 80;
        server_name ~^(?!paperless\.).*\.hermes\.local$;
        return 301 https://$host$request_uri;
    }

    # HTTP-only for Paperless (mobile app compatibility)
    server {
        listen 80;
        server_name paperless.hermes.local;
        location / {
            proxy_pass http://localhost:8000;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Forwarded-Server $host;
        }
    }

    # HTTPS servers
    server {
        listen 443 ssl;
        server_name hermes.local;
        ssl_certificate /etc/nginx/ssl/hermes.crt;
        ssl_certificate_key /etc/nginx/ssl/hermes.key;
        location / {
            proxy_pass http://localhost:8084;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }
    }

