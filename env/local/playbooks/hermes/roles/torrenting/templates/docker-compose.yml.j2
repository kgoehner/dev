---
services:
  gluetun:
    image: qmcgaw/gluetun:latest
    container_name: gluetun
    restart: unless-stopped
    cap_add:
      - NET_ADMIN
    environment:
      - VPN_SERVICE_PROVIDER={{ vault_vpn_provider }}
      - VPN_TYPE=openvpn
      - OPENVPN_USER={{ vault_vpn_username }}
      - OPENVPN_PASSWORD={{ vault_vpn_password }}
      - SERVER_COUNTRIES={{ vault_vpn_countries | default('Netherlands') }}
    ports:
      - "8086:8080"  # qBittorrent web UI
    volumes:
      - ./gluetun:/gluetun

  qbittorrent:
    image: lscr.io/linuxserver/qbittorrent:latest
    container_name: qbittorrent
    restart: unless-stopped
    network_mode: "service:gluetun"
    environment:
      - PUID=1000
      - PGID=1000
      - TZ={{ timezone }}
      - WEBUI_PORT=8080
    volumes:
      - ./qbittorrent:/config
      - /media/downloads:/downloads
    depends_on:
      - gluetun
