---
services:
  gluetun:
    image: qmcgaw/gluetun:latest
    container_name: gluetun
    restart: unless-stopped
    cap_add:
      - NET_ADMIN
    environment:
      - VPN_SERVICE_PROVIDER={{ vault_vpn_provider }}
      - VPN_TYPE=wireguard
      - WIREGUARD_PRIVATE_KEY={{ vault_vpn_private_key }}
      - WIREGUARD_PRESHARED_KEY={{ vault_vpn_preshared_key }}
      - WIREGUARD_ADDRESSES={{ vault_vpn_addresses }}
      - SERVER_COUNTRIES={{ vault_vpn_countries }}
    ports:
      - "8086:8080"  # qBittorrent web UI
    volumes:
      - ./gluetun:/gluetun
    networks:
      - arr_network

  qbittorrent:
    image: lscr.io/linuxserver/qbittorrent:latest
    container_name: qbittorrent
    restart: unless-stopped
    network_mode: "service:gluetun"
    environment:
      - PUID=1000
      - PGID=1000
      - TZ={{ timezone }}
      - WEBUI_PORT=8080
    volumes:
      - ./qbittorrent:/config
      - /mnt/atlas/media/downloads:/downloads
    depends_on:
      - gluetun

networks:
  arr_network:
    name: prowlarr_arr_network
    external: true
